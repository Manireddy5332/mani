# Local: http://localhost:3000
# Production: the canonical HTTPS origin with no path, query, or fragment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 5 - PostgreSQL and Prisma
# Use the pooled Neon URL for application queries. Neon pooled hostnames include
# "-pooler". Keep the TLS parameters provided by the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Use the non-pooled Neon URL for Prisma CLI migrations and explicit seeding.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Optional: use a separate empty database or Neon branch with `migrate dev`.
# SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@SHADOW_HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require

# Phase 6 - private administrator authentication
# Generate a high-entropy secret containing at least 32 characters. Never
# commit the real value.
BETTER_AUTH_SECRET=
# Local: http://localhost:3000
# Production: the exact same HTTPS origin as NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth web application credentials. For local development, configure
# these local settings in Google Cloud:
# authorized JavaScript origin: http://localhost:3000
# authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
# Production uses the final HTTPS origin and the same /api/auth/callback/google
# path. Prefer separate local and production OAuth clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The single verified Google identity allowed to create an admin session.
ADMIN_EMAIL=

# Optional Profile & About photo storage (server-only; not required for other CMS features).
# Connect a PRIVATE Vercel Blob store to provision BLOB_STORE_ID. Vercel supplies
# VERCEL_OIDC_TOKEN automatically; the SDK manages it. Never commit either value.
# BLOB_STORE_ID=
# For local development outside Vercel, a private-store token is an alternative:
# BLOB_READ_WRITE_TOKEN=
# Do not put Blob credentials in NEXT_PUBLIC_* variables.
